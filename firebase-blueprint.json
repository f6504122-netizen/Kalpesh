{
  "$schema": "https://firebase.google.com/schemas/firestore/blueprint/v1.json",
  "entities": {
    "User": {
      "collection": "users",
      "documentId": "userId",
      "fields": {
        "uid": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "photoURL": { "type": "string", "required": false },
        "status": { "type": "string", "required": false },
        "lastSeen": { "type": "timestamp", "required": false },
        "createdAt": { "type": "timestamp", "required": false }
      }
    },
    "Chat": {
      "collection": "chats",
      "documentId": "chatId",
      "fields": {
        "participants": { "type": "array", "required": true },
        "lastMessage": { "type": "string", "required": false },
        "lastMessageTimestamp": { "type": "timestamp", "required": false },
        "lastSenderId": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": true }
      }
    },
    "Message": {
      "collection": "chats/{chatId}/messages",
      "documentId": "messageId",
      "fields": {
        "chatId": { "type": "string", "required": true },
        "senderId": { "type": "string", "required": true },
        "senderName": { "type": "string", "required": true },
        "senderPhoto": { "type": "string", "required": false },
        "recipientId": { "type": "string", "required": true },
        "text": { "type": "string", "required": true },
        "timestamp": { "type": "timestamp", "required": true }
      }
    }
  }
}
